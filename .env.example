# ─── OpenRouter (AI Rewrite Engine) ──────────────────────────────────────
# Get your API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Model to use (default: openai/gpt-4o). Options: openai/gpt-4o, openai/gpt-4o-mini, anthropic/claude-3-haiku
# OPENROUTER_MODEL=openai/gpt-4o

# ─── Supabase ────────────────────────────────────────────────────────────
# Find these in your Supabase project dashboard > Settings > API
# For Google OAuth: go to Supabase Dashboard > Authentication > Providers > Google
# and add this redirect URL: https://your-app.com/auth/callback
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Resend (Email Delivery) ─────────────────────────────────────────────
# Get your API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ─── Stripe ──────────────────────────────────────────────────────────────
# Get your keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=price_your_annual_price_id

# ─── App URL (used for redirects) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry (Error Monitoring) ─────────────────────────────────────────────
# Get your DSN: https://sentry.io/settings/projects/procomm/keys/
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
